# Copy to .dev.vars for `npx wrangler dev` (it is git-ignored). In production set the
# secrets with `npx wrangler secret put <NAME>`; never put them in wrangler.jsonc.

# --- Medusa ---
# Medusa Admin > Settings > Secret API Keys. Sent as "Authorization: Basic <key>".
MEDUSA_ADMIN_API_KEY=sk_replace_me

# --- Business Central ---
# Client secret of the Entra ID app registered in BC (Microsoft Entra Applications).
BC_CLIENT_SECRET=replace_me

# --- Middleware ---
# Optional extra lock for /api/middleware/*; leave out to rely on Cloudflare Access.
# MIDDLEWARE_ADMIN_TOKEN=replace_me

# Non-secret settings live in the Cloudflare dashboard in production; locally set them here:
# BC_ENVIRONMENT_URL=https://api.businesscentral.dynamics.com/v2.0/<tenant>/Production
# BC_TENANT_ID=
# BC_CLIENT_ID=
# BC_COMPANY_ID=
# BC_AUTHORITY_URL=http://localhost:9555
